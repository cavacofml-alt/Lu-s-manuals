{
  "name": "Documentation Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000, 5173, 5432],
  "portsAttributes": {
    "8000": { "label": "API", "onAutoForward": "notify" },
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/Lu-s-manuals/backend/.venv/bin/python"
      }
    }
  },
  "remoteEnv": {
    "DATABASE_URL": "postgresql+psycopg://docintel:docintel@localhost:5432/docintel"
  }
}
